{
  "name": "prato-feito-backend",
  "module": "src/server.ts",
  "description": "API do PratoFeito, responsável por autenticação, publicações, comentários, reputação, votos e curadoria comunitária de conteúdos gastronômicos.",
  "packageManager": "bun@1.3.10",
  "private": true,
  "type": "module",
  "scripts": {
    "ci": "bun install --frozen-lockfile && bun run build",
    "start": "NODE_ENV=production bun dist/server.js",
    "dev": "NODE_ENV=development bun docker:up && bun wait-for-postgres:dev && bun migration:run && bun --watch src/server.ts",
    "build": "bunx tsc --noEmit && bun build src/server.ts --target=bun --outdir=dist",
    "test": "NODE_ENV=test bun docker:up && bun wait-for-postgres:test && bun migration:run && bun test --max-concurrency=1",
    "docker:up": "docker compose -f infra/compose.yaml up -d",
    "docker:down": "docker compose -f infra/compose.yaml down -v",
    "biome:check": "bunx biome check ./src ./tests ./infra --error-on-warnings",
    "biome:write": "bunx biome check ./src ./tests ./infra --write --unsafe",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:run": "node-pg-migrate -m infra/migrations --env-path .env.development up",
    "wait-for-postgres:dev": "NODE_ENV=development bun infra/scripts/wait-for-postgres.ts",
    "wait-for-postgres:test": "NODE_ENV=test bun infra/scripts/wait-for-postgres.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "fastify": "5.10.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/bun": "1.3.14",
    "@types/node": "24",
    "@types/pg": "8.20.0",
    "husky": "9.1.7",
    "node-pg-migrate": "8.0.4",
    "typescript": "7.0.2"
  }
}
